{
    "manifest_version": 3,
    "name": "Mandy Start",
    "version": "1.1.0",
    "description": "Lets the Mandy team start page learn from your browser history and find your open tabs. Nothing leaves your browser.",
    "permissions": [
        "history",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://aico-systems.github.io/StartPage/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "start@mandy.team",
            "strict_min_version": "121.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
